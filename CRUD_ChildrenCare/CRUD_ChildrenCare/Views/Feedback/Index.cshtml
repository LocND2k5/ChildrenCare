@model IReadOnlyList<CRUD_ChildrenCare.Models.Feedback>
@{
    ViewData["Title"] = "Customer Feedback & Reviews";
    var services = ViewBag.Services as IEnumerable<CRUD_ChildrenCare.Models.Service> ?? [];
    int? selectedServiceId = ViewBag.ServiceId as int?;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Customer Reviews</h1>
            <p class="text-muted mb-0">What parents and families say about our pediatric and healthcare services.</p>
        </div>
        <div>
            <a asp-action="Create" asp-route-serviceId="@selectedServiceId" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Send Your Feedback
            </a>
        </div>
    </div>

    <!-- Filter by service -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="form-label fw-semibold mb-0">Filter by Service:</label>
                </div>
                <div class="col-md-5">
                    <select name="serviceId" class="form-select" onchange="this.form.submit()">
                        <option value="">All Services & General Feedback</option>
                        @foreach (var s in services)
                        {
                            <option value="@s.Id" selected="@(selectedServiceId == s.Id)">@s.Title</option>
                        }
                    </select>
                </div>
                @if (selectedServiceId.HasValue)
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear Filter</a>
                    </div>
                }
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 card border-0 shadow-sm">
            <div class="py-4">
                <div class="display-4 text-muted mb-3">💬</div>
                <h4 class="text-muted">No feedbacks found yet.</h4>
                <p class="text-muted mb-3">Be the first to share your experience with us!</p>
                <a asp-action="Create" asp-route-serviceId="@selectedServiceId" class="btn btn-primary">
                    Write a Feedback
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0">@item.FullName</h5>
                                <small class="text-muted">@item.CreatedDate.ToString("dd/MM/yyyy")</small>
                            </div>
                            <div class="text-warning fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.RatedStar)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-25">★</span>
                                    }
                                }
                            </div>
                        </div>

                        @if (item.Service != null)
                        {
                            <div class="mb-2">
                                <span class="badge bg-light text-primary border">@item.Service.Title</span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-2">
                                <span class="badge bg-light text-secondary border">General Care</span>
                            </div>
                        }

                        <p class="card-text text-secondary mb-3">@item.Content</p>

                        @if (item.FeedbackImages != null && item.FeedbackImages.Any())
                        {
                            <div class="d-flex gap-2 flex-wrap mt-auto pt-2 border-top">
                                @foreach (var img in item.FeedbackImages)
                                {
                                    <a href="@img.ImageUrl" target="_blank" class="d-inline-block">
                                        <img src="@img.ImageUrl" class="rounded border shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" alt="Review photo" />
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
