@model HomeViewModel
@* [PART 2 - VIEW LAYER - PUBLIC - Home/Index.cshtml] *@

@{
    ViewData["Title"] = "Trang chủ - Children Care";
}

<!-- ===== SLIDER SECTION ===== -->
<section id="slider-section" class="slider-wrapper">
    @if (Model.Sliders.Any())
    {
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    <button type="button" data-bs-target="#heroCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Slide @(i+1)">
                    </button>
                }
            </div>

            <div class="carousel-inner">
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    var slider = Model.Sliders[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@slider.ImageUrl" class="d-block w-100" alt="@slider.Title"
                             style="max-height: 500px; object-fit: cover;">
                        <div class="carousel-caption d-none d-md-block">
                            <h2>@slider.Title</h2>
                            @if (!string.IsNullOrEmpty(slider.Description))
                            {
                                <p>@slider.Description</p>
                            }
                            @if (!string.IsNullOrEmpty(slider.LinkUrl))
                            {
                                <a href="@slider.LinkUrl" class="btn btn-primary">Xem thêm</a>
                            }
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    }
</section>

<!-- ===== FEATURED POSTS SECTION ===== -->
<section id="featured-posts" class="container my-5">
    <h2 class="mb-4 text-center">Bài viết nổi bật</h2>
    <div class="row g-4">
        @foreach (var post in Model.FeaturedPosts)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                    {
                        <img src="@post.ThumbnailUrl" class="card-img-top" alt="@post.Title"
                             style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@post.Title</h5>
                        <p class="card-text text-muted">@post.Summary</p>
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Blogs" asp-action="Details" asp-route-id="@post.Id"
                           class="btn btn-outline-primary btn-sm">Đọc tiếp →</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
