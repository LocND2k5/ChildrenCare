@model BlogListViewModel
@* [PART 2 - VIEW LAYER - PUBLIC - Blogs/Index.cshtml] *@

@{
    ViewData["Title"] = "Tin tức & Blog - Children Care";
}

<div class="container my-5">
    <h1 class="mb-4">Tin tức & Blog</h1>

    <!-- SEARCH FORM -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="search" value="@Model.SearchKeyword"
                   class="form-control" placeholder="Tìm kiếm bài viết...">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            @if (!string.IsNullOrEmpty(Model.SearchKeyword))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
            }
        </div>
    </form>

    <!-- POST LIST -->
    @if (Model.Posts.Any())
    {
        <div class="row g-4">
            @foreach (var post in Model.Posts)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                        {
                            <img src="@post.ThumbnailUrl" class="card-img-top" alt="@post.Title"
                                 style="height: 200px; object-fit: cover;">
                        }
                        <div class="card-body">
                            <h5 class="card-title">@post.Title</h5>
                            <p class="card-text text-muted small">@post.Summary</p>
                            <p class="text-muted small">
                                <i class="bi bi-calendar"></i> @post.CreatedAt.ToString("dd/MM/yyyy")
                                @if (post.Author != null)
                                {
                                    <span> | <i class="bi bi-person"></i> @post.Author.FullName</span>
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="Details" asp-route-id="@post.Id"
                               class="btn btn-outline-primary btn-sm">Đọc tiếp →</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Model.SearchKeyword">← Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@Model.SearchKeyword">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Model.SearchKeyword">Sau →</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">Không có bài viết nào.</div>
    }
</div>
