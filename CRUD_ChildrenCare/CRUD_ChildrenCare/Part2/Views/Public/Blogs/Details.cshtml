@model Post
@* [PART 2 - VIEW LAYER - PUBLIC - Blogs/Details.cshtml] *@

@{
    ViewData["Title"] = Model.Title + " - Children Care";
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Blogs" asp-action="Index">Blog</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <article>
        <h1 class="mb-3">@Model.Title</h1>
        <p class="text-muted mb-3">
            <i class="bi bi-calendar"></i> @Model.CreatedAt.ToString("dd/MM/yyyy")
            @if (Model.Author != null)
            {
                <span class="ms-3">
                    <i class="bi bi-person"></i> @Model.Author.FullName
                </span>
            }
        </p>

        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <img src="@Model.ThumbnailUrl" class="img-fluid rounded mb-4" alt="@Model.Title">
        }

        <div class="lead text-muted mb-4 fst-italic border-start border-4 ps-3">
            @Model.Summary
        </div>

        <div class="post-content">
            @Html.Raw(Model.Content)
        </div>
    </article>

    <hr>
    <a asp-controller="Blogs" asp-action="Index" class="btn btn-outline-secondary">
        ← Quay lại danh sách
    </a>
</div>
