@model SliderListViewModel
@* [PART 2 - VIEW LAYER - ADMIN - Sliders/Index.cshtml] *@

@{
    ViewData["Title"] = "Quản lý Slider";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý Slider trang chủ</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm Slider mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Thứ tự</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Sliders.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">Chưa có Slider nào.</td></tr>
                }
                @foreach (var slider in Model.Sliders)
                {
                    <tr>
                        <td>@slider.Id</td>
                        <td>
                            <img src="@slider.ImageUrl" alt="@slider.Title"
                                 style="width:100px; height:60px; object-fit:cover; border-radius:4px;">
                        </td>
                        <td>
                            <strong>@slider.Title</strong>
                            @if (!string.IsNullOrEmpty(slider.Description))
                            {
                                <br><small class="text-muted">@slider.Description</small>
                            }
                        </td>
                        <td>@slider.DisplayOrder</td>
                        <td>
                            @if (slider.Status == SliderStatus.Active)
                            {
                                <span class="badge bg-success">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã tắt</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@slider.Id"
                               class="btn btn-sm btn-outline-warning">Sửa</a>

                            <form asp-action="ToggleStatus" asp-route-id="@slider.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    @(slider.Status == SliderStatus.Active ? "Tắt" : "Bật")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
