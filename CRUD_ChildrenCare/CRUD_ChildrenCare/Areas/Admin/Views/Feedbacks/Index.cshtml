@model FeedbackListAdminViewModel
@{
    ViewData["Title"] = "Feedback Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Feedback Management</h2>
        <p class="text-muted mb-0">Review patient ratings, feedback comments, and manage public visibility.</p>
    </div>
</div>

<!-- Filters & Search -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search sender, content..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-3">
                <select name="serviceId" class="form-select">
                    <option value="">All Services</option>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id" selected="@(Model.ServiceId == s.Id)">@s.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="ratedStar" class="form-select">
                    <option value="">All Ratings</option>
                    <option value="5" selected="@(Model.RatedStar == 5)">5 Stars ★★★★★</option>
                    <option value="4" selected="@(Model.RatedStar == 4)">4 Stars ★★★★</option>
                    <option value="3" selected="@(Model.RatedStar == 3)">3 Stars ★★★</option>
                    <option value="2" selected="@(Model.RatedStar == 2)">2 Stars ★★</option>
                    <option value="1" selected="@(Model.RatedStar == 1)">1 Star ★</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var st in Enum.GetValues<FeedbackStatus>())
                    {
                        <option value="@st" selected="@(Model.Status == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-fill">Filter</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.ServiceId.HasValue || Model.RatedStar.HasValue || Model.Status.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Feedbacks Table -->
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Patient / Sender</th>
                <th>Service</th>
                <th>Rating</th>
                <th>Content Preview</th>
                <th>Photos</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Feedbacks.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">No feedbacks matching your criteria.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Feedbacks)
                {
                    <tr>
                        <td class="text-muted">@item.Id</td>
                        <td>
                            <div class="fw-semibold">@item.FullName</div>
                            <small class="text-muted">@item.Email</small>
                        </td>
                        <td>
                            @if (item.Service != null)
                            {
                                <span class="badge bg-light text-primary border">@item.Service.Title</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border">General Care</span>
                            }
                        </td>
                        <td>
                            <span class="text-warning fw-bold">@item.RatedStar ★</span>
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@item.Content">
                                @item.Content
                            </span>
                        </td>
                        <td>
                            @if (item.FeedbackImages.Any())
                            {
                                <span class="badge bg-info-subtle text-info border">@item.FeedbackImages.Count photo(s)</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(item.Status == FeedbackStatus.Published ? "bg-success" : "bg-secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Details">
                                    View
                                </a>
                                @if (Model.CanManage)
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Change visibility for this feedback?');">
                                        <button type="submit" class="btn @(item.Status == FeedbackStatus.Published ? "btn-outline-warning" : "btn-outline-success")">
                                            @(item.Status == FeedbackStatus.Published ? "Hide" : "Publish")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small">
            Showing page @Model.PageIndex of @Model.TotalPages (@Model.TotalItems total records)
        </div>
        <nav aria-label="Feedback pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageIndex - 1)"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-serviceId="@Model.ServiceId"
                       asp-route-ratedStar="@Model.RatedStar"
                       asp-route-status="@Model.Status"
                       asp-route-sort="@Model.Sort">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@p"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-serviceId="@Model.ServiceId"
                           asp-route-ratedStar="@Model.RatedStar"
                           asp-route-status="@Model.Status"
                           asp-route-sort="@Model.Sort">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageIndex + 1)"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-serviceId="@Model.ServiceId"
                       asp-route-ratedStar="@Model.RatedStar"
                       asp-route-status="@Model.Status"
                       asp-route-sort="@Model.Sort">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
